{
  "manifest_version": 3,
  "name": "AnyWeb MCP",
  "version": "0.1.0",
  "description": "Adds packaged WebMCP tools to supported websites.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://hn.algolia.com/*",
    "https://hacker-news.firebaseio.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.ie/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.se/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.sg/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.sa/*",
        "https://www.amazon.com.tr/*",
        "https://www.amazon.eg/*",
        "https://www.amazon.co.za/*",
        "https://*.ebay.com/*",
        "https://*.ebay.co.uk/*",
        "https://*.ebay.de/*",
        "https://*.ebay.fr/*",
        "https://*.ebay.it/*",
        "https://*.ebay.es/*",
        "https://*.ebay.ca/*",
        "https://*.ebay.com.au/*",
        "https://news.ycombinator.com/*",
        "https://www.linkedin.com/*",
        "https://www.producthunt.com/*",
        "https://producthunt.com/*",
        "https://www.temu.com/*",
        "https://www.reddit.com/*",
        "https://old.reddit.com/*",
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.amazon.com/*",
        "https://www.amazon.ca/*",
        "https://www.amazon.com.mx/*",
        "https://www.amazon.com.br/*",
        "https://www.amazon.co.uk/*",
        "https://www.amazon.ie/*",
        "https://www.amazon.de/*",
        "https://www.amazon.fr/*",
        "https://www.amazon.it/*",
        "https://www.amazon.es/*",
        "https://www.amazon.nl/*",
        "https://www.amazon.se/*",
        "https://www.amazon.pl/*",
        "https://www.amazon.com.be/*",
        "https://www.amazon.co.jp/*",
        "https://www.amazon.in/*",
        "https://www.amazon.com.au/*",
        "https://www.amazon.sg/*",
        "https://www.amazon.ae/*",
        "https://www.amazon.sa/*",
        "https://www.amazon.com.tr/*",
        "https://www.amazon.eg/*",
        "https://www.amazon.co.za/*"
      ],
      "js": ["sites/amazon.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.ebay.com/*",
        "https://*.ebay.co.uk/*",
        "https://*.ebay.de/*",
        "https://*.ebay.fr/*",
        "https://*.ebay.it/*",
        "https://*.ebay.es/*",
        "https://*.ebay.ca/*",
        "https://*.ebay.com.au/*"
      ],
      "js": ["sites/ebay.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://news.ycombinator.com/*"
      ],
      "js": ["sites/hackernews.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": ["sites/linkedin.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.producthunt.com/*",
        "https://producthunt.com/*"
      ],
      "js": ["sites/producthunt.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.temu.com/*"
      ],
      "js": ["sites/temu.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": ["sites/reddit.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["sites/x.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
