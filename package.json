{
  "name": "anywebmcp",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "packages/sites/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "release": "node scripts/release.mjs",
    "test": "node --test test/*.test.mjs && node scripts/run-workspace-tests.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "validate:sites": "node scripts/validate-sites.mjs",
    "codex:build": "npm run build -w @anywebmcp/extension && node packages/codex-launcher/bin/anywebmcp-codex.mjs build --mode=bundle --archive",
    "codex:release": "npm run build -w @anywebmcp/extension && node packages/codex-launcher/bin/anywebmcp-codex.mjs build --mode=bundle --notarize",
    "codex:install": "npm run build -w @anywebmcp/extension && node packages/codex-launcher/bin/anywebmcp-codex.mjs install --mode=dev",
    "codex:dev": "npm run build -w @anywebmcp/extension && node packages/codex-launcher/bin/anywebmcp-codex.mjs install --mode=dev --open",
    "codex:dev:standard": "npm run build -w @anywebmcp/extension && node packages/codex-launcher/bin/anywebmcp-codex.mjs install --mode=dev --profile=standard --open",
    "codex:open": "node packages/codex-launcher/bin/anywebmcp-codex.mjs open",
    "codex:doctor": "node packages/codex-launcher/bin/anywebmcp-codex.mjs doctor"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.12",
    "tldts": "^7.4.11",
    "typescript": "^5.9.0"
  }
}
